7f51\u4e0b\u8f7d\u9875\u9762</li> <li>\u4e0b\u8f7d Linux \u5b89\u88c5\u5305\uff08.deb \u6216 .rpm \u6587\u4ef6\uff09</li> <li>\u4f7f\u7528\u5305\u7ba1\u7406\u5668\u5b89\u88c5\uff1a</li> <li>Debian/Ubuntu\uff1a<code>sudo dpkg -i product.deb</code></li> <li>CentOS/RHEL\uff1a<code>sudo rpm -ivh product.rpm</code></li> </ol>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E5%AE%89%E8%A3%85/#_4","title":"\u65b9\u5f0f\u4e8c\uff1a\u4f7f\u7528\u5305\u7ba1\u7406\u5668","text":""},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E5%AE%89%E8%A3%85/#_5","title":"\u547d\u4ee4\u884c\u5b89\u88c5\uff08\u63a8\u8350\uff09","text":"<pre><code># \u4f7f\u7528 npm \u5b89\u88c5\nnpm install -g product-name\n\n# \u6216\u8005\u4f7f\u7528 yarn \u5b89\u88c5\nyarn global add product-name\n</code></pre>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E5%AE%89%E8%A3%85/#_6","title":"\u9a8c\u8bc1\u5b89\u88c5","text":"<p>\u5b89\u88c5\u5b8c\u6210\u540e\uff0c\u6253\u5f00\u7ec8\u7aef\uff08\u6216\u547d\u4ee4\u63d0\u793a\u7b26\uff09\uff0c\u8f93\u5165\u4ee5\u4e0b\u547d\u4ee4\u9a8c\u8bc1\u5b89\u88c5\uff1a</p> <pre><code>product --version\n</code></pre> <p>\u5982\u679c\u663e\u793a\u7248\u672c\u53f7\uff0c\u5219\u8bf4\u660e\u5b89\u88c5\u6210\u529f\u3002</p>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E9%A6%96%E6%AC%A1%E4%BD%BF%E7%94%A8/","title":"\u9996\u6b21\u4f7f\u7528","text":"<p>\u606d\u559c\u60a8\u6210\u529f\u5b89\u88c5\u4ea7\u54c1\uff01\u73b0\u5728\u8ba9\u6211\u4eec\u5f00\u59cb\u9996\u6b21\u4f7f\u7528\uff0c\u5b8c\u6210\u57fa\u672c\u914d\u7f6e\u3002</p>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E9%A6%96%E6%AC%A1%E4%BD%BF%E7%94%A8/#_2","title":"\u542f\u52a8\u4ea7\u54c1","text":"<ol> <li>\u6253\u5f00\u4ea7\u54c1\u5e94\u7528\u7a0b\u5e8f</li> <li>\u5982\u679c\u662f\u9996\u6b21\u542f\u52a8\uff0c\u4f1a\u663e\u793a\u6b22\u8fce\u5411\u5bfc</li> <li>\u6309\u7167\u5411\u5bfc\u5b8c\u6210\u57fa\u672c\u8bbe\u7f6e</li> </ol>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E9%A6%96%E6%AC%A1%E4%BD%BF%E7%94%A8/#_3","title":"\u914d\u7f6e\u8d26\u53f7","text":""},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E9%A6%96%E6%AC%A1%E4%BD%BF%E7%94%A8/#_4","title":"\u6ce8\u518c\u65b0\u8d26\u53f7","text":"<ol> <li>\u5728\u767b\u5f55\u9875\u9762\u70b9\u51fb\u300c\u6ce8\u518c\u300d</li> <li>\u586b\u5199\u90ae\u7bb1\u3001\u7528\u6237\u540d\u548c\u5bc6\u7801</li> <li>\u70b9\u51fb\u300c\u6ce8\u518c\u300d\u6309\u94ae</li> <li>\u67e5\u770b\u90ae\u7bb1\u5e76\u70b9\u51fb\u9a8c\u8bc1\u94fe\u63a5</li> <li>\u9a8c\u8bc1\u6210\u529f\u540e\uff0c\u4f7f\u7528\u65b0\u8d26\u53f7\u767b\u5f55</li> </ol>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E9%A6%96%E6%AC%A1%E4%BD%BF%E7%94%A8/#_5","title":"\u4f7f\u7528\u5df2\u6709\u8d26\u53f7\u767b\u5f55","text":"<ol> <li>\u5728\u767b\u5f55\u9875\u9762\u8f93\u5165\u90ae\u7bb1\u548c\u5bc6\u7801</li> <li>\u70b9\u51fb\u300c\u767b\u5f55\u300d\u6309\u94ae</li> <li>\u5982\u679c\u542f\u7528\u4e86\u4e8c\u6b65\u9a8c\u8bc1\uff0c\u8f93\u5165\u9a8c\u8bc1\u7801</li> <li>\u767b\u5f55\u6210\u529f\u540e\uff0c\u8fdb\u5165\u4ea7\u54c1\u4e3b\u754c\u9762</li> </ol>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E9%A6%96%E6%AC%A1%E4%BD%BF%E7%94%A8/#_6","title":"\u57fa\u672c\u8bbe\u7f6e","text":""},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E9%A6%96%E6%AC%A1%E4%BD%BF%E7%94%A8/#_7","title":"\u8bed\u8a00\u8bbe\u7f6e","text":"<ol> <li>\u70b9\u51fb\u53f3\u4e0a\u89d2\u5934\u50cf -&gt; \u300c\u8bbe\u7f6e\u300d</li> <li>\u5728\u300c\u8bed\u8a00\u300d\u9009\u9879\u4e2d\u9009\u62e9\u60a8\u559c\u6b22\u7684\u8bed\u8a00</li> <li>\u70b9\u51fb\u300c\u4fdd\u5b58\u300d\u6309\u94ae\uff0c\u754c\u9762\u4f1a\u81ea\u52a8\u5237\u65b0</li> </ol>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E9%A6%96%E6%AC%A1%E4%BD%BF%E7%94%A8/#_8","title":"\u4e3b\u9898\u8bbe\u7f6e","text":"<ol> <li>\u70b9\u51fb\u53f3\u4e0a\u89d2\u5934\u50cf -&gt; \u300c\u8bbe\u7f6e\u300d</li> <li>\u5728\u300c\u4e3b\u9898\u300d\u9009\u9879\u4e2d\u9009\u62e9\u300c\u6d45\u8272\u300d