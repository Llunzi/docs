{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4ea7\u54c1\u4f7f\u7528\u8bf4\u660e","text":"<p>\u6b22\u8fce\u4f7f\u7528\u672c\u4ea7\u54c1\uff01\u8fd9\u662f\u4e00\u4e2a\u89c4\u8303\u5316\u7684\u4ea7\u54c1\u4f7f\u7528\u6587\u6863\uff0c\u5e2e\u52a9\u60a8\u5feb\u901f\u4e0a\u624b\u5e76\u638c\u63e1\u4ea7\u54c1\u7684\u6838\u5fc3\u529f\u80fd\u3002</p>"},{"location":"#_2","title":"\u6587\u6863\u7ed3\u6784","text":"<p>\u672c\u6587\u6863\u5305\u542b\u4ee5\u4e0b\u6838\u5fc3\u6a21\u5757\uff1a</p> <ul> <li>\u5feb\u901f\u5f00\u59cb\uff1a\u5e2e\u52a9\u60a8\u5b8c\u6210\u4ea7\u54c1\u7684\u5b89\u88c5\u548c\u9996\u6b21\u4f7f\u7528</li> <li>\u529f\u80fd\u8bf4\u660e\uff1a\u8be6\u7ec6\u4ecb\u7ecd\u4ea7\u54c1\u7684\u6838\u5fc3\u529f\u80fd\u548c\u9ad8\u7ea7\u914d\u7f6e</li> <li>\u5e38\u89c1\u95ee\u9898\uff1a\u89e3\u7b54\u4f7f\u7528\u8fc7\u7a0b\u4e2d\u53ef\u80fd\u9047\u5230\u7684\u95ee\u9898</li> </ul>"},{"location":"#_3","title":"\u4f7f\u7528\u6307\u5357","text":"<ol> <li>\u9605\u8bfb\u300c\u5feb\u901f\u5f00\u59cb\u300d\u6a21\u5757\u5b8c\u6210\u4ea7\u54c1\u5b89\u88c5\u548c\u914d\u7f6e</li> <li>\u67e5\u770b\u300c\u529f\u80fd\u8bf4\u660e\u300d\u4e86\u89e3\u4ea7\u54c1\u7684\u5404\u9879\u529f\u80fd</li> <li>\u9047\u5230\u95ee\u9898\u65f6\u53ef\u53c2\u8003\u300c\u5e38\u89c1\u95ee\u9898\u300d\u6a21\u5757</li> </ol>"},{"location":"#_4","title":"\u53cd\u9988\u4e0e\u5efa\u8bae","text":"<p>\u5982\u679c\u60a8\u5728\u4f7f\u7528\u8fc7\u7a0b\u4e2d\u6709\u4efb\u4f55\u95ee\u9898\u6216\u5efa\u8bae\uff0c\u6b22\u8fce\u901a\u8fc7\u4ee5\u4e0b\u65b9\u5f0f\u8054\u7cfb\u6211\u4eec\uff1a</p> <ul> <li>\u63d0\u4ea4 Issue\uff1a\u5728 GitHub \u4ed3\u5e93\u63d0\u4ea4\u95ee\u9898\u53cd\u9988</li> <li>\u90ae\u4ef6\u8054\u7cfb\uff1asupport@example.com</li> </ul> <p>\u672c\u6587\u6863\u91c7\u7528 MkDocs \u6784\u5efa\uff0c\u4f7f\u7528 Material \u4e3b\u9898\uff0c\u652f\u6301\u5168\u6587\u641c\u7d22\u548c\u6697\u9ed1\u6a21\u5f0f\u3002</p>"},{"location":"faq/","title":"\u5e38\u89c1\u95ee\u9898","text":"<p>\u4ee5\u4e0b\u662f\u4f7f\u7528\u8fc7\u7a0b\u4e2d\u53ef\u80fd\u9047\u5230\u7684\u5e38\u89c1\u95ee\u9898\u53ca\u89e3\u7b54\u3002</p>"},{"location":"faq/#_2","title":"\u5b89\u88c5\u95ee\u9898","text":""},{"location":"faq/#q1","title":"Q1\uff1a\u5b89\u88c5\u8fc7\u7a0b\u4e2d\u63d0\u793a\u6743\u9650\u4e0d\u8db3","text":"<p>A1\uff1a\u8bf7\u4ee5\u7ba1\u7406\u5458\u8eab\u4efd\u8fd0\u884c\u5b89\u88c5\u7a0b\u5e8f\uff1a</p> <ul> <li>Windows\uff1a\u53f3\u952e\u70b9\u51fb\u5b89\u88c5\u7a0b\u5e8f\uff0c\u9009\u62e9\u300c\u4ee5\u7ba1\u7406\u5458\u8eab\u4efd\u8fd0\u884c\u300d</li> <li>macOS\uff1a\u6253\u5f00\u7ec8\u7aef\uff0c\u8f93\u5165 <code>sudo installer -pkg product.pkg -target /</code></li> <li>Linux\uff1a\u4f7f\u7528 <code>sudo</code> \u547d\u4ee4\u5b89\u88c5\uff0c\u5982 <code>sudo dpkg -i product.deb</code></li> </ul>"},{"location":"faq/#q2","title":"Q2\uff1a\u5b89\u88c5\u540e\u65e0\u6cd5\u542f\u52a8","text":"<p>A2\uff1a\u8bf7\u68c0\u67e5\u4ee5\u4e0b\u51e0\u70b9\uff1a</p> <ol> <li>\u786e\u8ba4\u7cfb\u7edf\u6ee1\u8db3\u6700\u4f4e\u8981\u6c42</li> <li>\u68c0\u67e5\u662f\u5426\u6709\u8db3\u591f\u7684\u5185\u5b58\u548c\u5b58\u50a8\u7a7a\u95f4</li> <li>\u67e5\u770b\u7cfb\u7edf\u65e5\u5fd7\uff0c\u67e5\u627e\u9519\u8bef\u4fe1\u606f</li> <li>\u5c1d\u8bd5\u91cd\u65b0\u5b89\u88c5\u4ea7\u54c1</li> </ol>"},{"location":"faq/#_3","title":"\u4f7f\u7528\u95ee\u9898","text":""},{"location":"faq/#q1_1","title":"Q1\uff1a\u5982\u4f55\u91cd\u7f6e\u5bc6\u7801","text":"<p>A1\uff1a\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u91cd\u7f6e\u5bc6\u7801\uff1a</p> <ol> <li>\u6253\u5f00\u767b\u5f55\u9875\u9762</li> <li>\u70b9\u51fb\u300c\u5fd8\u8bb0\u5bc6\u7801\u300d\u94fe\u63a5</li> <li>\u8f93\u5165\u60a8\u7684\u90ae\u7bb1\u5730\u5740</li> <li>\u67e5\u770b\u90ae\u7bb1\uff0c\u70b9\u51fb\u5bc6\u7801\u91cd\u7f6e\u94fe\u63a5</li> <li>\u8f93\u5165\u65b0\u5bc6\u7801\uff0c\u70b9\u51fb\u300c\u786e\u8ba4\u300d\u6309\u94ae</li> </ol>"},{"location":"faq/#q2_1","title":"Q2\uff1a\u5982\u4f55\u5bfc\u51fa\u9879\u76ee","text":"<p>A2\uff1a\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u5bfc\u51fa\u9879\u76ee\uff1a</p> <ol> <li>\u6253\u5f00\u9879\u76ee\u8be6\u60c5\u9875</li> <li>\u70b9\u51fb\u300c\u5bfc\u51fa\u300d\u6309\u94ae</li> <li>\u9009\u62e9\u5bfc\u51fa\u683c\u5f0f\uff08HTML/PDF/Markdown/JSON\uff09</li> <li>\u70b9\u51fb\u300c\u5bfc\u51fa\u300d\u6309\u94ae</li> <li>\u7b49\u5f85\u5bfc\u51fa\u5b8c\u6210\uff0c\u4fdd\u5b58\u6587\u4ef6\u5230\u672c\u5730</li> </ol>"},{"location":"faq/#q3","title":"Q3\uff1a\u5982\u4f55\u6dfb\u52a0\u9879\u76ee\u6210\u5458","text":"<p>A3\uff1a\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u6dfb\u52a0\u9879\u76ee\u6210\u5458\uff1a</p> <ol> <li>\u6253\u5f00\u9879\u76ee\u8be6\u60c5\u9875</li> <li>\u70b9\u51fb\u300c\u6210\u5458\u7ba1\u7406\u300d\u9009\u9879\u5361</li> <li>\u70b9\u51fb\u300c\u6dfb\u52a0\u6210\u5458\u300d\u6309\u94ae</li> <li>\u8f93\u5165\u6210\u5458\u90ae\u7bb1\u548c\u59d3\u540d</li> <li>\u9009\u62e9\u6210\u5458\u89d2\u8272\uff08admin/member/guest\uff09</li> <li>\u70b9\u51fb\u300c\u6dfb\u52a0\u300d\u6309\u94ae</li> </ol>"},{"location":"faq/#_4","title":"\u6280\u672f\u95ee\u9898","text":""},{"location":"faq/#q1_2","title":"Q1\uff1a\u9879\u76ee\u65e0\u6cd5\u52a0\u8f7d","text":"<p>A1\uff1a\u8bf7\u68c0\u67e5\u4ee5\u4e0b\u51e0\u70b9\uff1a</p> <ol> <li>\u786e\u8ba4\u7f51\u7edc\u8fde\u63a5\u6b63\u5e38</li> <li>\u68c0\u67e5\u9879\u76ee\u6587\u4ef6\u662f\u5426\u635f\u574f</li> <li>\u5c1d\u8bd5\u6e05\u9664\u6d4f\u89c8\u5668\u7f13\u5b58</li> <li>\u5c1d\u8bd5\u4f7f\u7528\u5176\u4ed6\u6d4f\u89c8\u5668</li> </ol>"},{"location":"faq/#q2_2","title":"Q2\uff1a\u6587\u4ef6\u65e0\u6cd5\u4fdd\u5b58","text":"<p>A2\uff1a\u8bf7\u68c0\u67e5\u4ee5\u4e0b\u51e0\u70b9\uff1a</p> <ol> <li>\u786e\u8ba4\u6709\u8db3\u591f\u7684\u5b58\u50a8\u7a7a\u95f4</li> <li>\u68c0\u67e5\u6587\u4ef6\u662f\u5426\u88ab\u5176\u4ed6\u7a0b\u5e8f\u5360\u7528</li> <li>\u5c1d\u8bd5\u91cd\u65b0\u767b\u5f55\u4ea7\u54c1</li> <li>\u67e5\u770b\u7cfb\u7edf\u65e5\u5fd7\uff0c\u67e5\u627e\u9519\u8bef\u4fe1\u606f</li> </ol>"},{"location":"faq/#_5","title":"\u53cd\u9988\u4e0e\u652f\u6301","text":"<p>\u5982\u679c\u60a8\u7684\u95ee\u9898\u4e0d\u5728\u4e0a\u8ff0\u5217\u8868\u4e2d\uff0c\u6216\u8005\u9700\u8981\u8fdb\u4e00\u6b65\u7684\u6280\u672f\u652f\u6301\uff0c\u8bf7\u901a\u8fc7\u4ee5\u4e0b\u65b9\u5f0f\u8054\u7cfb\u6211\u4eec\uff1a</p> <ul> <li>\u63d0\u4ea4 Issue\uff1a\u5728 GitHub \u4ed3\u5e93\u63d0\u4ea4\u95ee\u9898\u53cd\u9988</li> <li>\u90ae\u4ef6\u8054\u7cfb\uff1asupport@example.com</li> <li>\u5728\u7ebf\u5ba2\u670d\uff1a\u8bbf\u95ee\u4ea7\u54c1\u5b98\u7f51\uff0c\u70b9\u51fb\u300c\u5728\u7ebf\u5ba2\u670d\u300d</li> </ul> <p>\u6211\u4eec\u4f1a\u53ca\u65f6\u5904\u7406\u60a8\u7684\u95ee\u9898\u548c\u53cd\u9988\uff0c\u611f\u8c22\u60a8\u7684\u652f\u6301\uff01</p>"},{"location":"%E5%8A%9F%E8%83%BD%E8%AF%B4%E6%98%8E/%E6%A0%B8%E5%BF%83%E5%8A%9F%E8%83%BD/","title":"\u6838\u5fc3\u529f\u80fd","text":"<p>\u672c\u4ea7\u54c1\u63d0\u4f9b\u4ee5\u4e0b\u6838\u5fc3\u529f\u80fd\uff0c\u5e2e\u52a9\u60a8\u9ad8\u6548\u5b8c\u6210\u5de5\u4f5c\u4efb\u52a1\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E8%AF%B4%E6%98%8E/%E6%A0%B8%E5%BF%83%E5%8A%9F%E8%83%BD/#1","title":"1. \u9879\u76ee\u7ba1\u7406","text":""},{"location":"%E5%8A%9F%E8%83%BD%E8%AF%B4%E6%98%8E/%E6%A0%B8%E5%BF%83%E5%8A%9F%E8%83%BD/#_2","title":"\u521b\u5efa\u9879\u76ee","text":"<p>\u652f\u6301\u521b\u5efa\u4e0d\u540c\u7c7b\u578b\u7684\u9879\u76ee\uff0c\u5305\u62ec\uff1a</p> <ul> <li>Web \u9879\u76ee\uff1a\u9002\u7528\u4e8e\u7f51\u7ad9\u5f00\u53d1</li> <li>\u79fb\u52a8\u9879\u76ee\uff1a\u9002\u7528\u4e8e iOS/Android \u5e94\u7528\u5f00\u53d1</li> <li>\u684c\u9762\u9879\u76ee\uff1a\u9002\u7528\u4e8e Windows/macOS/Linux \u5e94\u7528\u5f00\u53d1</li> <li>\u5176\u4ed6\u9879\u76ee\uff1a\u9002\u7528\u4e8e\u81ea\u5b9a\u4e49\u9879\u76ee\u7c7b\u578b</li> </ul>"},{"location":"%E5%8A%9F%E8%83%BD%E8%AF%B4%E6%98%8E/%E6%A0%B8%E5%BF%83%E5%8A%9F%E8%83%BD/#_3","title":"\u9879\u76ee\u8bbe\u7f6e","text":"<p>\u53ef\u4ee5\u5bf9\u9879\u76ee\u8fdb\u884c\u4ee5\u4e0b\u8bbe\u7f6e\uff1a</p> <ul> <li>\u57fa\u672c\u4fe1\u606f\uff1a\u4fee\u6539\u9879\u76ee\u540d\u79f0\u3001\u63cf\u8ff0\u3001\u7c7b\u578b\u7b49</li> <li>\u6210\u5458\u7ba1\u7406\uff1a\u6dfb\u52a0/\u5220\u9664\u9879\u76ee\u6210\u5458\uff0c\u8bbe\u7f6e\u6210\u5458\u6743\u9650</li> <li>\u9879\u76ee\u914d\u7f6e\uff1a\u914d\u7f6e\u9879\u76ee\u7684\u5404\u79cd\u53c2\u6570\u548c\u9009\u9879</li> </ul>"},{"location":"%E5%8A%9F%E8%83%BD%E8%AF%B4%E6%98%8E/%E6%A0%B8%E5%BF%83%E5%8A%9F%E8%83%BD/#2","title":"2. \u6587\u4ef6\u7ba1\u7406","text":""},{"location":"%E5%8A%9F%E8%83%BD%E8%AF%B4%E6%98%8E/%E6%A0%B8%E5%BF%83%E5%8A%9F%E8%83%BD/#_4","title":"\u6587\u4ef6\u64cd\u4f5c","text":"<p>\u652f\u6301\u5bf9\u6587\u4ef6\u8fdb\u884c\u4ee5\u4e0b\u64cd\u4f5c\uff1a</p> <ul> <li>\u521b\u5efa\u6587\u4ef6\uff1a\u521b\u5efa\u65b0\u6587\u4ef6</li> <li>\u7f16\u8f91\u6587\u4ef6\uff1a\u7f16\u8f91\u73b0\u6709\u6587\u4ef6</li> <li>\u5220\u9664\u6587\u4ef6\uff1a\u5220\u9664\u4e0d\u518d\u9700\u8981\u7684\u6587\u4ef6</li> <li>\u91cd\u547d\u540d\u6587\u4ef6\uff1a\u4fee\u6539\u6587\u4ef6\u540d\u79f0</li> <li>\u79fb\u52a8\u6587\u4ef6\uff1a\u79fb\u52a8\u6587\u4ef6\u5230\u4e0d\u540c\u76ee\u5f55</li> </ul>"},{"location":"%E5%8A%9F%E8%83%BD%E8%AF%B4%E6%98%8E/%E6%A0%B8%E5%BF%83%E5%8A%9F%E8%83%BD/#_5","title":"\u6587\u4ef6\u7248\u672c\u63a7\u5236","text":"<p>\u652f\u6301\u6587\u4ef6\u7248\u672c\u63a7\u5236\uff0c\u60a8\u53ef\u4ee5\uff1a</p> <ul> <li>\u67e5\u770b\u5386\u53f2\u7248\u672c\uff1a\u67e5\u770b\u6587\u4ef6\u7684\u6240\u6709\u5386\u53f2\u7248\u672c</li> <li>\u6062\u590d\u7248\u672c\uff1a\u6062\u590d\u5230\u6587\u4ef6\u7684\u5386\u53f2\u7248\u672c</li> <li>\u5bf9\u6bd4\u7248\u672c\uff1a\u5bf9\u6bd4\u4e0d\u540c\u7248\u672c\u4e4b\u95f4\u7684\u5dee\u5f02</li> </ul>"},{"location":"%E5%8A%9F%E8%83%BD%E8%AF%B4%E6%98%8E/%E6%A0%B8%E5%BF%83%E5%8A%